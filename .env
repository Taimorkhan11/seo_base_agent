# ── AI Provider ────────────────────────────────────────────────────────────────
# Required: Anthropic Claude (used by all three agents)

# Optional: OpenAI (not used by default — available for future agent variants)
OPENAI_API_KEY=sk-...

# ── DataForSEO (real keyword data) ─────────────────────────────────────────────
# Sign up at https://dataforseo.com — free trial available
# Without these the pipeline falls back to heuristic volume/difficulty estimates
DATAFORSEO_LOGIN=your@email.com
DATAFORSEO_PASSWORD=your_api_password

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default, zero-config for development):
DATABASE_URL=sqlite:///dev.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_visibility

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string
PORT=5000
